## lib/CSV.stk — `use Arrow::CSV` (vectorized arrow-csv reader/writer)

package Arrow::CSV

use Arrow

## Read $path as CSV rows (header inferred).
fn Arrow::CSV::read ($path, %opts) {
    $opts{format} = "csv"
    Arrow::_read_impl($path, \%opts)
}

## Stream CSV rows: callback per row; returns count.
fn Arrow::CSV::read_stream ($path, %opts) {
    $opts{format} = "csv"
    Arrow::read_stream($path, %opts)
}

## Read CSV in columnar shape.
fn Arrow::CSV::read_columnar ($path, %opts) {
    $opts{format} = "csv"
    Arrow::_read_columnar_impl($path, \%opts)
}

## Write $rows to CSV at $path.
fn Arrow::CSV::write ($path, $rows, %opts) {
    $opts{format} = "csv"
    Arrow::_write_impl($path, $rows, \%opts)
}

## Write rows produced by $iter coderef to CSV.
fn Arrow::CSV::write_iter ($path, $iter, %opts) {
    $opts{format} = "csv"
    Arrow::write_iter($path, $iter, %opts)
}

## CSV schema (inferred from first batch).
fn Arrow::CSV::schema ($path) {
    Arrow::_schema_impl($path, { format => "csv" })
}

## CSV stats.
fn Arrow::CSV::stats ($path) {
    Arrow::_stats_impl($path, { format => "csv" })
}

