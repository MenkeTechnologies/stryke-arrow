## lib/Arrow.stk — Apache Arrow / Parquet / IPC / CSV / JSON for stryke.
##
## Thin wrapper around the `stryke-arrow` cdylib's `arrow__*` exports. The
## cdylib is dlopened in-process on first `use Arrow` (see stryke's
## `pkg/commands.rs::try_load_ffi_for`) and registers each export as a
## stryke-callable function via `rust_ffi::load_cdylib`.
##
## Replaces the v1 helper-binary model (fork(2) + exec(2) + NDJSON over a
## pipe). Stateless package — arrow operations don't carry process-level
## state between calls.

package Arrow

# ── error dispatch ────────────────────────────────────────────────────

## Decode the cdylib's JSON return; die on `{error}` payload.
fn Arrow::_decode ($name, $json) {
    val $o = from_json $json
    if (ref $o eq "HASH" && exists $o->{error}) {
        die "Arrow::$name: $o->{error}"
    }
    $o
}

# ── version ──────────────────────────────────────────────────────────

## Return the package version string.
fn Arrow::version {
    val $o = Arrow::_decode("version", arrow__version("{}"))
    $o->{version}
}

# ── read ─────────────────────────────────────────────────────────────

## Read $path as Arrow rows; opts: format, columns, limit, skip, batch_size.
fn Arrow::read ($path, %opts) {
    Arrow::_read_impl($path, \%opts)
}

## Internal read implementation; see public wrappers.
fn Arrow::_read_impl ($path, $o) {
    val %req = (
        path => $path,
        format => $o->{format},
        columns => $o->{columns},
        limit => $o->{limit},
        skip => $o->{skip},
        batch_size => $o->{batch_size},
    )
    val $res = Arrow::_decode("read", arrow__read(to_json(\%req)))
    @{ $res->{rows} }
}

## Callback fires per row. The cdylib returns all rows in one call.
fn Arrow::read_stream ($path, %opts) {
    die "Arrow::read_stream: callback => sub { … } required" unless defined $opts{callback}
    val $cb = $opts{callback}
    val @rows = Arrow::_read_impl($path, \%opts)
    var $n = 0
    for val $row (@rows) {
        $cb->($row)
        $n++
    }
    $n
}

## Columnar shape: { columns, num_rows, data => { col => [vals] } }.
fn Arrow::read_columnar ($path, %opts) {
    Arrow::_read_columnar_impl($path, \%opts)
}

## Internal columnar-read implementation; see public wrappers.
fn Arrow::_read_columnar_impl ($path, $o) {
    val %req = (
        path => $path,
        format => $o->{format},
        columns => $o->{columns},
        limit => $o->{limit},
        skip => $o->{skip},
    )
    Arrow::_decode("read_columnar", arrow__read_columnar(to_json(\%req)))
}

# ── schema + stats ───────────────────────────────────────────────────

## Schema { fields: [{name, type, nullable}, ...] }.
fn Arrow::schema ($path, %opts) {
    Arrow::_schema_impl($path, \%opts)
}

## Internal schema implementation; see public wrappers.
fn Arrow::_schema_impl ($path, $o) {
    val %req = (path => $path, format => $o->{format})
    Arrow::_decode("schema", arrow__schema(to_json(\%req)))
}

## Footer-driven stats for parquet; scan-based for others.
fn Arrow::stats ($path, %opts) {
    Arrow::_stats_impl($path, \%opts)
}

## Internal stats implementation; see public wrappers.
fn Arrow::_stats_impl ($path, $o) {
    val %req = (path => $path, format => $o->{format})
    Arrow::_decode("stats", arrow__stats(to_json(\%req)))
}

## Row count (shortcut over stats()).
fn Arrow::row_count ($path, %opts) {
    val $o = Arrow::stats($path, %opts)
    $o->{num_rows}
}

# ── write ────────────────────────────────────────────────────────────

## Write $rows (arrayref) to $path. Opts: format, compression, row_group.
fn Arrow::write ($path, $rows, %opts) {
    Arrow::_write_impl($path, $rows, \%opts)
}

## Internal write implementation; see public wrappers.
fn Arrow::_write_impl ($path, $rows, $o) {
    die "Arrow::write: rows must be arrayref" unless ref($rows) eq "ARRAY"
    val %req = (
        path => $path,
        rows => $rows,
        format => $o->{format},
        compression => $o->{compression},
        row_group => $o->{row_group},
    )
    Arrow::_decode("write", arrow__write(to_json(\%req)))
}

## Streaming write: $iter is a coderef returning a row at a time (undef = EOF).
## We buffer + write in one shot; the in-process FFI removes the per-row
## pipe-flush latency the v1 helper paid for incremental writes.
fn Arrow::write_iter ($path, $iter, %opts) {
    var @rows
    while (defined (val $row = $iter->())) {
        push @rows, $row
    }
    Arrow::_write_impl($path, \@rows, \%opts)
}

# ── convert ──────────────────────────────────────────────────────────

## Read $src and write $dst in possibly different formats.
fn Arrow::convert ($src, $dst, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("convert", arrow__convert(to_json(\%req)))
}


# ── compute ──────────────────────────────────────────────────────────
#
# File→file transforms over the `arrow__*` compute exports: read $src, apply
# an Arrow kernel, write $dst. dst format defaults to the dst extension (else
# the src format). opts: src_format, dst_format, compression, row_group.

## Keep rows where $column $op $value. op ∈ eq|ne|lt|le|gt|ge.
fn Arrow::filter ($src, $dst, $column, $op, $value, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        column => $column,
        op => $op,
        value => $value,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("filter", arrow__filter(to_json(\%req)))
}

## Keep rows where $column is in $values (an arrayref) — SQL IN. Each value is
## coerced to the column type; an empty set matches no rows.
fn Arrow::filter_in ($src, $dst, $column, $values, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        column => $column,
        values => $values,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("filter_in", arrow__filter_in(to_json(\%req)))
}

## Keep rows where $column is NOT in $values (an arrayref) — SQL NOT IN, the
## complement of filter_in. A null value is kept (it matches nothing), like
## pandas ~isin; an empty set keeps every row.
fn Arrow::filter_not_in ($src, $dst, $column, $values, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        column => $column,
        values => $values,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("filter_not_in", arrow__filter_not_in(to_json(\%req)))
}

## Project/reorder columns. $cols is an arrayref of names in output order.
fn Arrow::select ($src, $dst, $cols, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        columns => $cols,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("select", arrow__select(to_json(\%req)))
}

## Drop columns, keeping the rest in original order — complement of select.
## $cols is an arrayref of names to remove; each must exist. Returns the
## surviving column names under `columns`.
fn Arrow::drop ($src, $dst, $cols, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        columns => $cols,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("drop", arrow__drop(to_json(\%req)))
}

## Drop duplicate rows, keeping the first occurrence of each distinct row in
## input order. Comparison spans every column. Returns { dst, rows, dropped }.
fn Arrow::distinct ($src, $dst, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("distinct", arrow__distinct(to_json(\%req)))
}

## Drop rows that are null in any of $cols (an arrayref of names; omit or pass
## undef to check every column). Returns { dst, rows, dropped }.
fn Arrow::drop_nulls ($src, $dst, $cols = undef, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        columns => $cols,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("drop_nulls", arrow__drop_nulls(to_json(\%req)))
}

## Fill nulls in $cols (an arrayref of names; omit or pass undef for every
## column) with the constant $value, typed to match each column — the fill
## companion to drop_nulls. Row count is unchanged. Returns { dst, rows, filled }.
fn Arrow::fill_null ($src, $dst, $value, $cols = undef, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        value => $value,
        columns => $cols,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("fill_null", arrow__fill_null(to_json(\%req)))
}

## Sort rows. $by is an arrayref of { column => name, descending => bool }.
fn Arrow::sort ($src, $dst, $by, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        by => $by,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("sort", arrow__sort(to_json(\%req)))
}

## Reverse the row order (last row first) — independent of any sort key. Returns
## { dst, rows }.
fn Arrow::reverse ($src, $dst, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("reverse", arrow__reverse(to_json(\%req)))
}

## First $n rows.
fn Arrow::head ($src, $dst, $n, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        n => $n,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("head", arrow__head(to_json(\%req)))
}

## Last $n rows.
fn Arrow::tail ($src, $dst, $n, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        n => $n,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("tail", arrow__tail(to_json(\%req)))
}

## Rows in the half-open window [$offset, $offset+$length).
fn Arrow::slice ($src, $dst, $offset, $length, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        offset => $offset,
        length => $length,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("slice", arrow__slice(to_json(\%req)))
}

## Concatenate $srcs (arrayref of paths, identical schema) into $dst.
fn Arrow::concat ($srcs, $dst, %opts) {
    val %req = (
        srcs => $srcs,
        dst => $dst,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("concat", arrow__concat(to_json(\%req)))
}

## Rename columns. $map is { old => new }; unmapped columns pass through.
fn Arrow::rename ($src, $dst, $map, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        map => $map,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("rename", arrow__rename(to_json(\%req)))
}

## Cast columns. $casts is { column => type } (int|int32|float|float32|str|bool).
fn Arrow::cast ($src, $dst, $casts, %opts) {
    val %req = (
        src => $src,
        dst => $dst,
        casts => $casts,
        src_format => $opts{src_format},
        dst_format => $opts{dst_format},
        compression => $opts{compression},
        row_group => $opts{row_group},
    )
    Arrow::_decode("cast", arrow__cast(to_json(\%req)))
}

## Row count read straight from the source (no JSON materialization).
fn Arrow::count ($path, %opts) {
    val %req = (
        src => $path,
        format => $opts{format},
    )
    Arrow::_decode("count", arrow__count(to_json(\%req)))->{rows}
}

## Per-column null count as a hashref { null_counts => { col => n, … }, rows } —
## the data-quality accessor (pandas isnull().sum(), polars null_count()).
fn Arrow::null_counts ($path, %opts) {
    val %req = (
        src => $path,
        format => $opts{format},
    )
    Arrow::_decode("null_counts", arrow__null_counts(to_json(\%req)))
}

## The (rows, columns) shape of the source as a hashref { rows, columns } — the
## canonical DataFrame shape accessor (pandas/polars .shape).
fn Arrow::shape ($path, %opts) {
    val %req = (
        src => $path,
        format => $opts{format},
    )
    Arrow::_decode("shape", arrow__shape(to_json(\%req)))
}


# ── convenience composites ──────────────────────────────────────────
#
# Pure-stryke helpers over schema / row_count — no new FFI. The slurpy
# %opts (carrying `format`) is forwarded directly as the trailing splat;
# never copy it to a local or add pairs after it (stryke BUG-306).

## Column names in file order. column_names("data.arrow") → ["id","name",…].
fn Arrow::column_names ($path, %opts) {
    [ map { $_->{name} } @{ Arrow::schema($path, %opts)->{fields} } ]
}

## Number of columns in the file's schema.
fn Arrow::column_count ($path, %opts) {
    scalar @{ Arrow::schema($path, %opts)->{fields} }
}

## True if the file has zero data rows (schema may still be present).
fn Arrow::is_empty ($path, %opts) {
    Arrow::row_count($path, %opts) == 0 ? 1 : 0
}
