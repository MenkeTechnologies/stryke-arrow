#!/usr/bin/env stryke
# examples/dataframe_bridge.stk — load parquet straight into a stryke
# DataFrame, then run stryke's columnar ops on it.
#
# Run:    s examples/dataframe_bridge.stk path/to/sales.parquet

use Arrow::DataFrame

val $path = $ARGV[0]
die "usage: dataframe_bridge.stk PATH.parquet\n" unless defined $path

val $df = Arrow::DataFrame::load($path)

# At this point $df is either a stryke DataFrame (with ->filter / ->group_by /
# ->sum / ->nrow / ->ncol) or, if dataframe() isn't built into this stryke,
# the columnar hash { col => [vals] }.

if (ref($df) eq "HASH") {
    p "loaded " . scalar(keys %$df) . " columns; stryke build has no dataframe() builtin"
    for val $col (keys %$df) {
        p "  $col: " . scalar(@{ $df->{$col} }) . " values"
    }
} else {
    p "loaded stryke DataFrame: " . $df->nrow . " rows × " . $df->ncol . " cols"
}
