# t/test_arrow.stk — round-trip tests against the in-process cdylib.
#
# Requires the cdylib to be loaded. Install once with `s pkg install -g .`
# from the package root so stryke's FFI bridge dlopens
# lib/libstryke_arrow.{dylib,so} on `use Arrow`.

use Arrow
use Arrow::Parquet
use Arrow::IPC
use Arrow::CSV
use Arrow::JSON

val $have_cdylib = eval { Arrow::version(); 1 }
unless ($have_cdylib) {
    p "1..0 # SKIP cdylib not loaded — run `s pkg install -g .` first"
    exit 0
}

# Tiny dataset that exercises ints, floats, strings, nulls.
val @rows = (
    { id => 1, name => "alice",   score => 1.5,  city => "ny" },
    { id => 2, name => "bob",     score => 2.0,  city => undef },
    { id => 3, name => "charlie", score => 3.25, city => "sf" },
    { id => 4, name => "dana",    score => 4.0,  city => "la" },
)

val $tmp = "/tmp/stryke-arrow-test-$$"
mkdir $tmp unless -d $tmp

val @tests = (
    { name => "parquet round-trip", file => "$tmp/x.parquet" },
    { name => "ipc round-trip",     file => "$tmp/x.arrow"   },
    { name => "csv round-trip",     file => "$tmp/x.csv"     },
    { name => "json round-trip",    file => "$tmp/x.json"    },
    { name => "feather round-trip", file => "$tmp/x.feather" },
)
val $plan = scalar(@tests) * 3 + 4
p "1..$plan"

var $i = 0
for val $t (@tests) {
    val $path = $t->{file}
    val $name = $t->{name}

    eval {
        Arrow::write($path, \@rows)
        $i++
        p "ok $i - $name write"
    }
    if ($@) {
        $i++
        p "not ok $i - $name write: $@"
        $i++
        p "not ok $i - $name read skipped"
        $i++
        p "not ok $i - $name rowcount skipped"
        next
    }

    var @back
    eval { @back = Arrow::read($path) }
    $i++
    if ($@) {
        p "not ok $i - $name read: $@"
    } else {
        var $ok = scalar(@back) == scalar(@rows) && $back[0]->{name} eq "alice"
        p ($ok ? "ok $i - $name read" : "not ok $i - $name read (got " . scalar(@back) . " rows)")
    }

    var $stats
    eval { $stats = Arrow::stats($path) }
    $i++
    if ($@) {
        p "not ok $i - $name stats: $@"
    } else {
        var $ok = $stats->{num_rows} == 4 && $stats->{num_columns} == 4
        p ($ok ? "ok $i - $name stats" : "not ok $i - $name stats (rows=$stats->{num_rows} cols=$stats->{num_columns})")
    }
}

# schema test: parquet
var $sch
eval { $sch = Arrow::schema("$tmp/x.parquet") }
$i++
if ($@) {
    p "not ok $i - parquet schema: $@"
} else {
    var $ok = ref($sch->{fields}) eq "ARRAY" && scalar(@{ $sch->{fields} }) == 4
    p ($ok ? "ok $i - parquet schema" : "not ok $i - parquet schema bad shape")
}

# columnar test
var $cw
eval { $cw = Arrow::read_columnar("$tmp/x.parquet") }
$i++
if ($@) {
    p "not ok $i - parquet read_columnar: $@"
} else {
    var $ok = $cw->{num_rows} == 4
              && ref($cw->{columns}) eq "HASH"
              && exists $cw->{columns}{id}
    p ($ok ? "ok $i - parquet read_columnar" : "not ok $i - parquet read_columnar bad shape")
}

# convert: parquet → csv
var $rc
eval { $rc = Arrow::convert("$tmp/x.parquet", "$tmp/conv.csv") }
$i++
if ($@) {
    p "not ok $i - convert parquet→csv: $@"
} else {
    var $ok = -e "$tmp/conv.csv" && -s "$tmp/conv.csv" > 0
    p ($ok ? "ok $i - convert parquet→csv" : "not ok $i - convert parquet→csv empty")
}

# column projection
var @proj
eval { @proj = Arrow::read("$tmp/x.parquet", columns => ["id", "name"]) }
$i++
if ($@) {
    p "not ok $i - parquet column projection: $@"
} else {
    val $ok = scalar(@proj) == 4
              && !exists $proj[0]->{score}
              && exists $proj[0]->{id}
              && exists $proj[0]->{name}
    p ($ok ? "ok $i - parquet column projection" : "not ok $i - parquet column projection wrong fields")
}

# cleanup
for val $t (@tests) {
    unlink $t->{file} if -e $t->{file}
}
unlink "$tmp/conv.csv" if -e "$tmp/conv.csv"
rmdir $tmp if -d $tmp
