## t/test_arrow.stk — assertion tests for the stryke `Arrow` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Requires the cdylib to be loaded — install once with `s pkg install -g .`
## from the package root so stryke's FFI bridge dlopens
## `lib/libstryke_arrow.{dylib,so}` on `use Arrow`.

use Arrow
use Arrow::Parquet
use Arrow::IPC
use Arrow::CSV
use Arrow::JSON

# ── cdylib reachability ──────────────────────────────────────────────
val $version = Arrow::version()
assert_ok $version, "Arrow::version returns truthy (cdylib loaded)"
assert_match qr/^\d+/, $version, "Arrow::version starts with a digit"

# ── round-trip dataset ───────────────────────────────────────────────
# Tiny dataset that exercises ints, floats, strings, nulls.
val @rows = (
    { id => 1, name => "alice",   score => 1.5,  city => "ny" },
    { id => 2, name => "bob",     score => 2.0,  city => undef },
    { id => 3, name => "charlie", score => 3.25, city => "sf" },
    { id => 4, name => "dana",    score => 4.0,  city => "la" },
)

val $tmp = "/tmp/stryke-arrow-test-$$"
mkdir $tmp unless -d $tmp

var @formats = (
    { name => "parquet", file => "$tmp/x.parquet" },
    { name => "ipc",     file => "$tmp/x.arrow"   },
    { name => "csv",     file => "$tmp/x.csv"     },
    { name => "json",    file => "$tmp/x.json"    },
    { name => "feather", file => "$tmp/x.feather" },
)

# Per-format: write, read-back row count, name preservation, stats shape.
for val $t (@formats) {
    val $path = $t->{file}
    val $name = $t->{name}

    Arrow::write($path, \@rows)
    assert_ok -e $path, "$name: write produces file"

    val @back = Arrow::read($path)
    assert_eq scalar(@back), 4, "$name: read returns 4 rows"
    assert_eq $back[0]->{name}, "alice", "$name: first row name preserved"

    val $stats = Arrow::stats($path)
    assert_eq $stats->{num_rows}, 4, "$name: stats.num_rows == 4"
    assert_eq scalar(@{$stats->{columns}}), 4, "$name: stats.columns has 4 entries"
}

# ── parquet-specific: schema shape ───────────────────────────────────
val $sch = Arrow::schema("$tmp/x.parquet")
assert_eq ref($sch->{fields}), "ARRAY", "parquet schema.fields is array"
assert_eq scalar(@{ $sch->{fields} }), 4, "parquet schema has 4 fields"

# ── columnar read ────────────────────────────────────────────────────
val $cw = Arrow::read_columnar("$tmp/x.parquet")
assert_eq $cw->{num_rows}, 4, "parquet columnar: 4 rows"
assert_eq ref($cw->{data}), "HASH", "parquet columnar.data is hash"
assert_ok exists $cw->{data}{id}, "parquet columnar has id column in data"

# ── format conversion: parquet → csv ─────────────────────────────────
Arrow::convert("$tmp/x.parquet", "$tmp/conv.csv")
assert_ok -e "$tmp/conv.csv", "convert parquet→csv produces file"
assert_gt(-s("$tmp/conv.csv"), 0, "convert parquet→csv file is non-empty")

# ── column projection ────────────────────────────────────────────────
val @proj = Arrow::read("$tmp/x.parquet", columns => ["id", "name"])
assert_eq scalar(@proj), 4, "projection preserves row count"
assert_ok exists $proj[0]->{id}, "projection includes id"
assert_ok exists $proj[0]->{name}, "projection includes name"
assert_ok !exists $proj[0]->{score}, "projection excludes score"

# ── cleanup ──────────────────────────────────────────────────────────
for val $t (@formats) {
    unlink $t->{file} if -e $t->{file}
}
unlink "$tmp/conv.csv" if -e "$tmp/conv.csv"
rmdir $tmp if -d $tmp

test_run
